# -----------------------------------------------------------------------------
# PromptVault — Environment Configuration Template
# Copy this file to `.env` for local development. NEVER commit real secrets.
# -----------------------------------------------------------------------------

# Runtime environment: development | production
ENVIRONMENT=development

# Enable interactive OpenAPI docs (/docs, /redoc). Defaults to true in dev, false in prod.
# ENABLE_API_DOCS=false

# Required in production (minimum 32 random characters).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed by CORS (no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request hardening
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_ENABLED=true

# Supabase PostgreSQL persistence (optional locally — falls back to in-memory seed data)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI integration for AI Studio (optional — falls back to built-in heuristic engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
